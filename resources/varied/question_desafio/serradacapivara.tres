[resource]
script = ExtResource("2_7wupk")
question_info = "O Parque Nacional Serra da Capivara, no Piauí, é um dos maiores santuários arqueológicos do planeta. O local é famoso por abrigar a maior concentração de pinturas rupestres do mundo e por abrigar vestígios que desafiam as teorias tradicionais sobre a chegada dos primeiros humanos às Américas."
question_image = ExtResource("1_1k1rl")
options = Array[String](["Parque Sete Cidades", "Serra da Capivara", "Nascentes do Parnaíba"])
correct = "Serra da Capivara"
