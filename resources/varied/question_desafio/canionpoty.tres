[resource]
script = ExtResource("2_7thsq")
question_info = "O Cânion do Rio Poti, localizado na divisa entre o Ceará e o Piauí, é um santuário ecológico de 180 km de extensão com paredões rochosos que chegam a 60 metros de altura. Sua principal entrada é feita pelos municípios piauienses de Castelo do Piauí e Buriti dos Montes."
question_image = ExtResource("1_gpjq5")
options = Array[String](["Cânion do Poty", "Cânion do Gurguéia", "Cânion do Canidé"])
correct = "Cânion do Poty"
