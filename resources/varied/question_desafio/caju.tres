[resource]
script = ExtResource("2_iigwn")
question_info = "O caju é o símbolo do estado do Piauí, que possui a segunda maior área plantada do país. A grande curiosidade é que o que chamamos de fruta (a parte carnosa, amarela ou vermelha) é na verdade um pseudofruto. O verdadeiro fruto do cajueiro é a própria castanha!"
question_image = ExtResource("1_3pxdv")
options = Array[String](["Carnaúba", "Pequi", "Caju"])
correct = "Caju"
metadata/_custom_type_script = "uid://dsacn43yg1b3x"
