[resource]
script = ExtResource("2_x4ims")
question_info = "Santa Cruz dos Milagres é um pequeno município piauiense (a cerca de 180 km de Teresina) e a 3ª maior romaria do Nordeste. O local atrai centenas de milhares de devotos anualmente, impulsionado por uma lenda de fé e por ser o único Santuário no estado reconhecido pelo Vaticano."
